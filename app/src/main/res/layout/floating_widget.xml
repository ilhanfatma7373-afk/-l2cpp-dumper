<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Collapsed Floating Icon -->
    <FrameLayout
        android:id="@+id/collapsed_iv"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="#CC000000"
        android:padding="8dp">

        <ImageView
            android:id="@+id/anonymous_logo_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Floating Logo"
            android:src="@drawable/anonymous_logo" />
    </FrameLayout>

    <!-- Expanded Hacker Terminal Panel -->
    <LinearLayout
        android:id="@+id/expanded_container"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="#EE0A0A0E"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_menu_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="start|center_vertical"
                android:text="Anonim v1.0 Dumper"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_menu"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="#222222"
                android:fontFamily="monospace"
                android:text="X"
                android:textColor="#FF0000"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="#00FF00" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="[TARGET GAME: CONNECTED &amp; LOCKED]"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- ID: 9 START IL2CPP DUMPER BUTTON -->
        <Button
            android:id="@+id/btn_start_dumper"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#111111"
            android:fontFamily="monospace"
            android:text="[ID: 9] START IL2CPP DUMPER"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <TextView
            android:id="@+id/tv_dumper_status"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#080808"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:text="[root@anonymous:~# waiting for action...]\n[1500+ master offsets ready]"
            android:textColor="#00FF00"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
